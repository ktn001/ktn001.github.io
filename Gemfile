source "https://rubygems.org"

# Cette gem contient toutes les dépendances et versions exactes utilisées par GitHub Pages
# Elle inclut automatiquement Jekyll et les plugins autorisés par GitHub
gem "github-pages", group: :jekyll_plugins

# Plugin recommandé pour la gestion native du thème par défaut (Minima) si vous l'utilisez
gem "minima", "~> 2.5"

# Dépendance obligatoire pour Windows (et recommandée pour éviter les avertissements sur Debian)
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]

# Permet de sécuriser et d'isoler l'exécution des commandes Jekyll sous Linux
gem "webrick", "~> 1.8"

